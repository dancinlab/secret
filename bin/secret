#!/usr/bin/env bash
# secret — encrypted-file credential CLI (macOS Keychain-free).
# Storage: a single openssl-encrypted file `store.enc` living inside a private
#          git checkout (default ~/.local/share/secret/, $SECRET_GITHUB_PATH
#          override). The store is decrypted in-memory with a master password —
#          no macOS Keychain, no GUI security session. Works headless / over ssh
#          / on linux.
#
# Plaintext store format (never written to disk — in-memory only):
#   one line per entry:  <key><TAB>base64(value)
#   base64 encoding makes multiline / binary / ssh-key values line-safe.
#
# Encryption (@L1): openssl enc -aes-256-cbc -pbkdf2 -salt -iter 200000,
#   password supplied via `-pass stdin` (NEVER argv — no ps-aux leak).
#
# Master password source priority (@L3):
#   1. $SECRET_MASTER            (env — headless / CI / ssh)
#   2. ~/.config/secret/master   (0600 file, trailing newline stripped)
#   3. tty prompt (read -s)      (interactive)
#   argv is NEVER accepted for the master password.
#
# Backend for multi-device sync:
#   The encrypted `store.enc` is committed + pushed to a private git repo
#   (`secret backup` / `secret sync`). Git carries only the ciphertext.
#   Cross-device = `git clone` + `secret init github <url>` + the SAME master pw.
#
# Subcommands (admin):
#   secret init github <git-url>     one-time per-device setup, github backend
#   secret backup                    commit + push the encrypted store
#   secret sync                      git pull --rebase + push
#   secret migrate --from-keychain   one-shot import from the old macOS keychain
#                                    (Mac GUI session only — see notes)
#
# Auto-backup: ON by default — set/rotate/delete auto-commit+push store.enc when
# a git target is configured. SECRET_BACKUP_AUTO=0 opts out for one call.
#
# High-value protection (BIP39 mnemonic · xprv/xpub · WIF)
#   - default REFUSE on `set` (wallet-grade · elevated leak risk)
#   - bare 64-hex (SHA-256 / R2 key / HMAC / ETH privkey) → WARN, not refuse
#   - explicit override: `secret set <key> --allow-mnemonic`
#   - argv REFUSED for high-value (ps aux leak); stdin/tty ONLY
set -euo pipefail

SVC="${SECRET_SERVICE:-dancinlab.secret}"
GITHUB_CHECKOUT_DEFAULT="$HOME/.local/share/secret"
# The encrypted store lives inside the git checkout.
STORE_DIR="${SECRET_GITHUB_PATH:-$GITHUB_CHECKOUT_DEFAULT}"
STORE_ENC="$STORE_DIR/store.enc"
# Legacy macOS keychain file (kept during the transition — @L4; migrate source).
KC="${SECRET_KEYCHAIN:-$HOME/Library/Keychains/dancinlab.keychain-db}"

ITER=200000

# ANSI color. TTY-only on stderr + NO_COLOR opt-out.
if [ -t 2 ] && [ -z "${NO_COLOR:-}" ]; then
  _C_STEP=$'\033[36m'    # cyan
  _C_OK=$'\033[1;32m'    # bold green
  _C_FAIL=$'\033[1;31m'  # bold red
  _C_WARN=$'\033[33m'    # yellow
  _C_DIM=$'\033[90m'     # gray
  _C_RST=$'\033[0m'
else
  _C_STEP=""; _C_OK=""; _C_FAIL=""; _C_WARN=""; _C_DIM=""; _C_RST=""
fi

_die() { printf '%ssecret:%s %s\n' "$_C_FAIL" "$_C_RST" "$*" >&2; exit 2; }

# ─── master password source (@L3) ───────────────────────────────────────────
# Priority: $SECRET_MASTER → ~/.config/secret/master (0600) → tty prompt.
# Prints the password (one line, no trailing newline) to stdout for capture via
# a subshell / process substitution. NEVER taken from argv. _die if unavailable.
_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/secret"
_MASTER_FILE="$_CONFIG_DIR/master"

_master_password() {
  if [ -n "${SECRET_MASTER:-}" ]; then
    printf '%s' "$SECRET_MASTER"
    return 0
  fi
  if [ -f "$_MASTER_FILE" ]; then
    # strip a single trailing newline (and any trailing CR), preserve the rest
    local pw; pw=$(cat "$_MASTER_FILE")
    printf '%s' "$pw"
    return 0
  fi
  if [ -t 0 ] || [ -r /dev/tty ]; then
    local pw
    printf '%smaster password:%s ' "$_C_DIM" "$_C_RST" >&2
    # read from the controlling tty even when stdin is a pipe
    if [ -r /dev/tty ]; then
      IFS= read -rs pw < /dev/tty || true
    else
      IFS= read -rs pw || true
    fi
    printf '\n' >&2
    if [ -z "$pw" ]; then
      _die "no master password entered"
    fi
    printf '%s' "$pw"
    return 0
  fi
  _die "no master password: set \$SECRET_MASTER, create $_MASTER_FILE (0600), or run on a tty"
}

# ─── encrypted store layer (@L1 @L2 @L5) ────────────────────────────────────
# Decrypt store.enc → plaintext (key<TAB>base64val lines) on stdout.
# Empty output if store.enc is absent. Ciphertext via -in (file on disk is
# fine), master password fed on fd 3 via process substitution — NEVER argv.
#   (`-pass stdin` cannot coexist with piping data through stdin, so we use the
#    fd: form, which keeps the password off argv just the same — @L1 intent.)
_store_decrypt() {
  [ -f "$STORE_ENC" ] || return 0
  local out rc
  out=$(openssl enc -d -aes-256-cbc -pbkdf2 -iter "$ITER" \
        -pass fd:3 -in "$STORE_ENC" 3< <(_master_password) 2>/dev/null) && rc=0 || rc=$?
  if [ "${rc:-0}" -ne 0 ]; then
    _die "decrypt failed — wrong master password or corrupt store"
  fi
  printf '%s' "$out"
}

# Encrypt stdin (plaintext lines) → store.enc, atomically (mktemp .enc → mv).
# The temp file holds CIPHERTEXT only — no plaintext ever hits disk (@L5).
# Plaintext flows in on stdin (openssl default -in), master password on fd 3.
_store_encrypt() {
  mkdir -p "$STORE_DIR"
  local tmp
  tmp=$(mktemp "$STORE_DIR/.store.enc.XXXXXX") || _die "mktemp failed"
  if openssl enc -aes-256-cbc -pbkdf2 -salt -iter "$ITER" \
       -pass fd:3 -out "$tmp" 3< <(_master_password); then
    chmod 600 "$tmp" 2>/dev/null || true
    mv -f "$tmp" "$STORE_ENC"
  else
    rm -f "$tmp"
    _die "encrypt failed"
  fi
}

# _store_get <key> → decode + print value to stdout. exit 1 (no output) if absent.
_store_get() {
  local key="$1" line b64
  line=$(_store_decrypt | awk -F'\t' -v k="$key" '$1==k{print $2; found=1} END{exit !found}') || return 1
  [ -n "$line" ] || return 1
  printf '%s' "$line" | base64 -d
}

# _store_has <key> → exit 0 if present, 1 otherwise. No value output.
_store_has() {
  local key="$1"
  _store_decrypt | awk -F'\t' -v k="$key" '$1==k{found=1} END{exit !found}'
}

# _store_set <key> <value> → in-memory rewrite (drop old key line, append new),
# value base64-encoded so multiline / binary stays line-safe. Re-encrypt.
_store_set() {
  local key="$1" val="$2" plain b64
  b64=$(printf '%s' "$val" | base64 | tr -d '\n')
  plain=$(_store_decrypt | awk -F'\t' -v k="$key" '$1!=k')
  {
    # preserve existing lines (sans the replaced key), then the new entry
    [ -n "$plain" ] && printf '%s\n' "$plain"
    printf '%s\t%s\n' "$key" "$b64"
  } | _store_encrypt
}

# _store_delete <key> → drop the key line, re-encrypt. exit 1 if key absent.
_store_delete() {
  local key="$1" plain
  if ! _store_has "$key"; then return 1; fi
  plain=$(_store_decrypt | awk -F'\t' -v k="$key" '$1!=k')
  if [ -n "$plain" ]; then
    printf '%s\n' "$plain" | _store_encrypt
  else
    # store now empty — write an empty (but valid) encrypted blob
    printf '' | _store_encrypt
  fi
}

# _store_list → keys only (first TAB-field), one per line.
_store_list() {
  _store_decrypt | awk -F'\t' 'NF>0 && $1!=""{print $1}'
}

# ─── git backup (store.enc) ─────────────────────────────────────────────────
_require_store_dir() {
  if [ ! -d "$STORE_DIR/.git" ]; then
    printf '%ssecret:%s no git store at %s%s%s\n' \
      "$_C_FAIL" "$_C_RST" "$_C_DIM" "$STORE_DIR" "$_C_RST" >&2
    printf '  Run %s`secret init github <url>`%s.\n' "$_C_OK" "$_C_RST" >&2
    exit 1
  fi
}

# Backup target = the store's git checkout (or a configured mirror).
_MIRROR_CONFIG="$_CONFIG_DIR/mirror_path"
_mirror_path() { if [ -f "$_MIRROR_CONFIG" ]; then cat "$_MIRROR_CONFIG"; fi; }

_backup_target() {
  if [ -d "$STORE_DIR/.git" ]; then printf '%s' "$STORE_DIR"; return; fi
  local m; m=$(_mirror_path)
  if [ -n "$m" ] && [ -d "$m/.git" ]; then printf '%s' "$m"; return; fi
}

# After a successful store write, commit + push store.enc. ON by default.
# Errors are non-fatal (warning only). Mirror = copy store.enc into the target.
_maybe_auto_backup() {
  [ "${SECRET_BACKUP_AUTO:-1}" = "0" ] && return 0
  local target; target=$(_backup_target)
  [ -n "$target" ] || return 0
  (
    if [ "$target" != "$STORE_DIR" ]; then
      cp "$STORE_ENC" "$target/store.enc" 2>/dev/null || {
        printf '%sbackup:%s could not copy store.enc to mirror %s%s%s — vault NOT updated\n' \
          "$_C_WARN" "$_C_RST" "$_C_DIM" "$target" "$_C_RST" >&2; exit 1; }
    fi
    cd "$target" || {
      printf '%sbackup:%s cannot enter %s%s%s — vault NOT updated\n' \
        "$_C_WARN" "$_C_RST" "$_C_DIM" "$target" "$_C_RST" >&2; exit 1; }
    if git diff --quiet -- store.enc 2>/dev/null && git diff --cached --quiet -- store.enc 2>/dev/null; then
      exit 0
    fi
    git add -- store.enc >/dev/null 2>&1 || {
      printf '%sbackup:%s git add failed — store.enc NOT pushed; run %ssecret sync%s later\n' \
        "$_C_WARN" "$_C_RST" "$_C_OK" "$_C_RST" >&2; exit 1; }
    if ! git commit -m "auto: $(date '+%Y-%m-%d %H:%M:%S')" >/dev/null 2>&1; then
      printf '%sbackup:%s git commit failed — store.enc saved locally but NOT in the vault.\n' \
        "$_C_WARN" "$_C_RST" >&2
      printf '  Most often a missing git identity. Set it once, then run %ssecret sync%s:\n' \
        "$_C_OK" "$_C_RST" >&2
      printf '    git config --global user.email "you@example.com"\n' >&2
      printf '    git config --global user.name  "Your Name"\n' >&2
      exit 1
    fi
    if git push >/dev/null 2>&1; then
      printf '%sbackup:%s pushed\n' "$_C_DIM" "$_C_RST" >&2
    else
      printf '%sbackup:%s commit ok, push failed — run %ssecret sync%s later\n' \
        "$_C_WARN" "$_C_RST" "$_C_OK" "$_C_RST" >&2
    fi
  ) || true
}

# ─── high-value protection (preserved) ──────────────────────────────────────
_SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
_WORDLIST="${_SCRIPT_DIR}/../data/bip39_english.txt"

# TTY guard — restore `stty echo` if interrupted mid-prompt (only when on a tty;
# running stty without a controlling terminal would otherwise taint exit status).
_has_tty() { [ -t 0 ] && [ -t 1 ]; }
trap '_has_tty && stty echo 2>/dev/null; true' EXIT INT TERM

is_high_value_secret() {
  local val="$1"
  local wc
  wc=$(printf '%s' "$val" | wc -w | tr -d ' ')
  case "$wc" in
    12|15|18|21|24)
      if printf '%s' "$val" | grep -Eq '^[a-z]+( [a-z]+)*$'; then
        if [ -f "$_WORDLIST" ]; then
          local invalid
          invalid=$(printf '%s\n' $val | grep -vxFf "$_WORDLIST" 2>/dev/null | wc -l | tr -d ' ')
          if [ "$invalid" = "0" ]; then return 0; fi
        else
          return 0
        fi
      fi
      ;;
  esac
  if printf '%s' "$val" | grep -Eq '^(xprv|xpub|yprv|ypub|zprv|zpub)[A-HJ-NP-Za-km-z1-9]{100,}$'; then return 0; fi
  if printf '%s' "$val" | grep -Eq '^[5KL][A-HJ-NP-Za-km-z1-9]{50,51}$'; then return 0; fi
  return 1
}

is_hex64_value() {
  printf '%s' "$1" | grep -Eq '^(0x)?[0-9a-fA-F]{64}$'
}

# ─── secret init github ─────────────────────────────────────────────────────
# Clone (or re-use) a private git checkout that holds store.enc.
_do_init_github() {
  local url="$1"
  [ -n "$url" ] || _die "init github: usage — secret init github <git-url>"

  local checkout="$STORE_DIR"
  mkdir -p "$(dirname "$checkout")"

  if [ -d "$checkout/.git" ]; then
    local current; current=$(cd "$checkout" && git remote get-url origin 2>/dev/null || true)
    if [ -n "$current" ] && [ "$current" != "$url" ]; then
      _die "init github: existing checkout at $checkout has different origin: $current"
    fi
    printf '%sstep:%s re-using existing git checkout at %s%s%s\n' \
      "$_C_STEP" "$_C_RST" "$_C_DIM" "$checkout" "$_C_RST" >&2
    (cd "$checkout" && git pull --ff-only --quiet 2>&1 | head -3 || true)
  elif [ -e "$checkout" ]; then
    _die "init github: $checkout exists but is not a git checkout — refusing"
  else
    printf '%sstep:%s cloning %s%s%s → %s%s%s\n' \
      "$_C_STEP" "$_C_RST" "$_C_DIM" "$url" "$_C_RST" "$_C_DIM" "$checkout" "$_C_RST" >&2
    if ! git clone "$url" "$checkout" 2>&1 | tail -5; then
      _die "init github: clone failed — verify the repo exists and you have access"
    fi
  fi

  if [ -f "$STORE_ENC" ]; then
    printf '%sstep:%s found existing encrypted store: %s%s%s\n' \
      "$_C_STEP" "$_C_RST" "$_C_DIM" "$STORE_ENC" "$_C_RST" >&2
  else
    printf '%sstep:%s no store yet — first %ssecret set%s will create one.\n' \
      "$_C_STEP" "$_C_RST" "$_C_OK" "$_C_RST" >&2
    printf '       The master password is the SOLE decryption secret —\n' >&2
    printf '       use the %sSAME%s password on every device.\n' "$_C_WARN" "$_C_RST" >&2
  fi

  printf '\n%s✓ secret init github done.%s\n' "$_C_OK" "$_C_RST" >&2
  printf '    repo:           %s%s%s\n' "$_C_DIM" "$url" "$_C_RST" >&2
  printf '    local checkout: %s%s%s\n' "$_C_DIM" "$checkout" "$_C_RST" >&2
  printf '    store:          %s%s%s\n' "$_C_DIM" "$STORE_ENC" "$_C_RST" >&2
  printf '\nMaster password: %s$SECRET_MASTER%s env → %s~/.config/secret/master%s (0600) → tty prompt.\n' \
    "$_C_OK" "$_C_RST" "$_C_OK" "$_C_RST" >&2
  printf 'Next: %ssecret set <key> <value>%s — auto-pushes the encrypted store.\n' \
    "$_C_OK" "$_C_RST" >&2
}

# ─── backup config ──────────────────────────────────────────────────────────
_do_backup() {
  case "${1:-}" in
    enable)
      shift
      local url="${1:-}"; local path="${2:-$HOME/.local/share/secret-archive}"
      [ -n "$url" ] || _die "backup enable: usage — secret backup enable <git-url> [<local-path>]"
      mkdir -p "$(dirname "$path")"
      if [ -d "$path/.git" ]; then
        local current; current=$(cd "$path" && git remote get-url origin 2>/dev/null || true)
        if [ -n "$current" ] && [ "$current" != "$url" ]; then
          _die "backup enable: existing checkout at $path has different origin: $current"
        fi
        printf '%sstep:%s re-using existing checkout at %s%s%s\n' \
          "$_C_STEP" "$_C_RST" "$_C_DIM" "$path" "$_C_RST" >&2
      elif [ -e "$path" ]; then
        _die "backup enable: $path exists but is not a git checkout"
      else
        printf '%sstep:%s cloning %s%s%s → %s%s%s\n' \
          "$_C_STEP" "$_C_RST" "$_C_DIM" "$url" "$_C_RST" "$_C_DIM" "$path" "$_C_RST" >&2
        git clone "$url" "$path" 2>&1 | tail -5 || _die "backup enable: clone failed"
      fi
      mkdir -p "$_CONFIG_DIR"
      printf '%s\n' "$path" > "$_MIRROR_CONFIG"
      printf '%sok:%s mirror enabled → %s%s%s\n' "$_C_OK" "$_C_RST" "$_C_DIM" "$path" "$_C_RST" >&2
      printf '       Auto-push is %sON by default%s — every set/rotate/delete commits+pushes.\n' \
        "$_C_OK" "$_C_RST" >&2
      return 0
      ;;
    disable)
      if [ -f "$_MIRROR_CONFIG" ]; then
        local was; was=$(_mirror_path)
        rm -f "$_MIRROR_CONFIG"
        printf '%sok:%s mirror disabled %s(checkout at %s left intact)%s\n' \
          "$_C_OK" "$_C_RST" "$_C_DIM" "$was" "$_C_RST" >&2
      else
        printf '%sbackup:%s no mirror was configured\n' "$_C_DIM" "$_C_RST" >&2
      fi
      return 0
      ;;
    status)
      printf 'store:      %s%s%s\n' "$_C_DIM" "$STORE_ENC" "$_C_RST"
      printf 'git store:  %s%s%s\n' "$_C_DIM" "$([ -d "$STORE_DIR/.git" ] && echo yes || echo no)" "$_C_RST"
      local m; m=$(_mirror_path)
      if [ -n "$m" ]; then
        printf 'mirror:     %s%s%s\n' "$_C_DIM" "$m" "$_C_RST"
        if [ -d "$m/.git" ]; then
          local remote; remote=$(cd "$m" && git remote get-url origin 2>/dev/null || echo "?")
          printf 'mirror url: %s%s%s\n' "$_C_DIM" "$remote" "$_C_RST"
        else
          printf '%swarn:%s mirror path is not a git checkout\n' "$_C_WARN" "$_C_RST"
        fi
      else
        printf 'mirror:     %s(not configured)%s\n' "$_C_DIM" "$_C_RST"
      fi
      local auto_state="on (default)"
      [ "${SECRET_BACKUP_AUTO:-1}" = "0" ] && auto_state="off (SECRET_BACKUP_AUTO=0)"
      printf 'auto-push:  %s%s%s\n' "$_C_DIM" "$auto_state" "$_C_RST"
      return 0
      ;;
    "") : ;;  # fall through to push
    *) _die "backup: unknown subcommand '$1' (expected: enable | disable | status | <empty for push>)" ;;
  esac

  local target; target=$(_backup_target)
  if [ -z "$target" ]; then
    _die "backup: no target configured. Run 'secret init github <url>' or 'secret backup enable <git-url>' first."
  fi
  [ -f "$STORE_ENC" ] || _die "backup: no store.enc yet — run 'secret set' first"
  if [ "$target" != "$STORE_DIR" ]; then cp "$STORE_ENC" "$target/store.enc"; fi
  cd "$target"
  git add -- store.enc
  if ! git diff --cached --quiet; then
    git commit -m "snapshot: $(date '+%Y-%m-%d %H:%M:%S')" >/dev/null 2>&1
    printf '%sstep:%s commit ok\n' "$_C_STEP" "$_C_RST" >&2
  fi
  if git push 2>&1 | tail -3; then
    printf '%s✓ backup:%s pushed to %s%s%s\n' "$_C_OK" "$_C_RST" "$_C_DIM" "$target" "$_C_RST" >&2
  else
    _die "backup: push failed (check network / credentials)"
  fi
}

# ─── secret sync ────────────────────────────────────────────────────────────
_do_sync() {
  local target; target=$(_backup_target)
  if [ -z "$target" ]; then
    _die "sync: no target configured. Run 'secret init github <url>' first."
  fi
  cd "$target"
  printf '%sstep:%s git pull --rebase at %s%s%s\n' "$_C_STEP" "$_C_RST" "$_C_DIM" "$target" "$_C_RST" >&2
  if ! git pull --rebase 2>&1 | tail -5; then
    _die "sync: pull/rebase failed — resolve conflicts and retry"
  fi
  # If the mirror target is not the primary store dir, copy the synced blob back.
  if [ "$target" != "$STORE_DIR" ] && [ -f "$target/store.enc" ]; then
    mkdir -p "$STORE_DIR"
    cp "$target/store.enc" "$STORE_ENC"
    printf '%sstep:%s restored primary store from mirror\n' "$_C_STEP" "$_C_RST" >&2
  fi
  if [ -f "$STORE_ENC" ]; then
    if [ "$target" != "$STORE_DIR" ]; then cp "$STORE_ENC" "$target/store.enc"; fi
    git add -- store.enc >/dev/null 2>&1 || true
    if ! git diff --cached --quiet; then
      git commit -m "snapshot: $(date '+%Y-%m-%d %H:%M:%S')" >/dev/null 2>&1
    fi
  fi
  printf '%sstep:%s git push\n' "$_C_STEP" "$_C_RST" >&2
  git push 2>&1 | tail -3
  printf '%s✓ sync:%s done\n' "$_C_OK" "$_C_RST" >&2
}

# ─── secret migrate --from-keychain ─────────────────────────────────────────
# One-shot import of the OLD macOS keychain entries into the new store.enc.
# macOS GUI session ONLY — `security find-generic-password -w` requires the Aqua
# security session; over ssh / headless it returns empty ("User interaction is
# not allowed"). Run once from Terminal.app on the Mac.
_do_migrate() {
  case "${1:-}" in
    --from-keychain) : ;;
    -h|--help|"")
      cat >&2 <<EOF
usage: secret migrate --from-keychain [--purge-source]

One-shot import of the legacy macOS keychain (\$SECRET_KEYCHAIN, default
~/Library/Keychains/dancinlab.keychain-db) into the new encrypted store.enc.

  --from-keychain   read every entry with service=\$SECRET_SERVICE from the old
                    keychain and write it into store.enc (re-encrypted).
  --purge-source    after a verified copy, delete originals from the keychain.

NOTE: macOS Keychain reads require a GUI (Aqua) security session — run this
from Terminal.app on the Mac, NOT over ssh / headless (which returns empty).
EOF
      [ -z "${1:-}" ] && exit 1 || exit 0
      ;;
    *) _die "migrate: unknown arg '$1' (expected: --from-keychain)" ;;
  esac

  local purge=0 a
  for a in "$@"; do
    case "$a" in
      --from-keychain) ;;
      --purge-source)  purge=1 ;;
      *) _die "migrate: unknown arg '$a'" ;;
    esac
  done

  command -v security >/dev/null 2>&1 || _die "migrate --from-keychain: 'security' CLI not found — macOS only"
  [ -e "$KC" ] || _die "migrate --from-keychain: legacy keychain not found at $KC"

  printf '%sstep:%s reading legacy keychain %s%s%s (service=%s)\n' \
    "$_C_STEP" "$_C_RST" "$_C_DIM" "$KC" "$_C_RST" "$SVC" >&2

  local src_keys=() k
  while IFS= read -r k; do
    [ -n "$k" ] && src_keys+=("$k")
  done < <(security dump-keychain "$KC" 2>/dev/null | awk -v svc="$SVC" '
    /^keychain:/ { acct=""; sv="" }
    /"acct"<blob>=/ { gsub(/.*"acct"<blob>="?|"?$/,""); acct=$0 }
    /"svce"<blob>=/ { gsub(/.*"svce"<blob>="?|"?$/,""); sv=$0
                      if (sv == svc && acct != "") print acct }
  ')

  local n="${#src_keys[@]}"
  if [ "$n" -eq 0 ]; then
    printf '%smigrate:%s no entries with service=%s in %s. Nothing to do.\n' \
      "$_C_WARN" "$_C_RST" "$SVC" "$KC" >&2
    printf '       (If this ran over ssh, retry from Terminal.app on the Mac —\n' >&2
    printf '        keychain reads need a GUI security session.)\n' >&2
    exit 0
  fi

  printf '%sstep:%s %d entries to import\n' "$_C_STEP" "$_C_RST" "$n" >&2

  local ok=0 fail=0 val read_back key
  for key in "${src_keys[@]}"; do
    if ! val=$(security find-generic-password -a "$key" -s "$SVC" -w "$KC" 2>/dev/null); then
      printf '  %s[SKIP]%s %s — could not read from keychain\n' "$_C_WARN" "$_C_RST" "$key" >&2
      fail=$((fail+1)); continue
    fi
    _store_set "$key" "$val"
    read_back=$(_store_get "$key" 2>/dev/null || true)
    if [ "$read_back" = "$val" ]; then
      printf '  %s[ok]%s   %s  %s(%d bytes)%s\n' \
        "$_C_OK" "$_C_RST" "$key" "$_C_DIM" "${#val}" "$_C_RST" >&2
      ok=$((ok+1))
      if [ "$purge" -eq 1 ]; then
        security delete-generic-password -a "$key" -s "$SVC" "$KC" >/dev/null 2>&1 \
          || printf '    %s[warn]%s purge failed for %s\n' "$_C_WARN" "$_C_RST" "$key" >&2
      fi
    else
      printf '  %s[FAIL]%s %s — verification mismatch\n' "$_C_FAIL" "$_C_RST" "$key" >&2
      fail=$((fail+1))
    fi
    unset val read_back
  done

  printf '\n%ssummary:%s %s%d ok%s, %s%d failed%s (of %d)\n' \
    "$_C_STEP" "$_C_RST" "$_C_OK" "$ok" "$_C_RST" \
    "$( [ "$fail" -gt 0 ] && echo "$_C_FAIL" || echo "$_C_OK" )" "$fail" "$_C_RST" "$n" >&2
  [ "$ok" -gt 0 ] && _maybe_auto_backup
  exit $(( fail > 0 ? 1 : 0 ))
}

# ─── verb dispatch ──────────────────────────────────────────────────────────
case "${1:-}" in
  get)
    [ $# -ge 2 ] || _die "usage: secret get <key>"
    _store_get "$2" || { printf '%ssecret:%s no such key: %s\n' "$_C_FAIL" "$_C_RST" "$2" >&2; exit 1; }
    ;;

  set)
    shift
    allow_mnemonic=0
    posargs=()
    for a in "$@"; do
      case "$a" in
        --allow-mnemonic) allow_mnemonic=1 ;;
        --*) _die "set: unknown flag '$a'" ;;
        *) posargs+=("$a") ;;
      esac
    done
    [ "${#posargs[@]}" -ge 1 ] || _die "usage: secret set [--allow-mnemonic] <key> [value]"
    key="${posargs[0]}"
    val=""
    val_from_argv=0
    if [ "${#posargs[@]}" -ge 2 ]; then
      val="${posargs[1]}"
      val_from_argv=1
    elif [ -t 0 ]; then
      # interactive tty — single-line hidden prompt
      printf '%svalue for %s:%s ' "$_C_DIM" "$key" "$_C_RST" >&2
      stty -echo 2>/dev/null || true
      IFS= read -r val || true
      stty echo 2>/dev/null || true
      printf '\n' >&2
    else
      # piped stdin — read ALL of it (multiline / binary ssh-key safe).
      # Preserve exact bytes incl. embedded/trailing newlines.
      val=$(cat; printf x); val="${val%x}"
    fi
    if is_high_value_secret "$val"; then
      if [ "$allow_mnemonic" -eq 0 ]; then
        printf '%ssecret:%s high-value secret detected %s(BIP39 mnemonic · xprv/xpub · WIF)%s\n' \
          "$_C_FAIL" "$_C_RST" "$_C_DIM" "$_C_RST" >&2
        printf '  refusing by default — wallet-grade secret with elevated leak risk.\n' >&2
        printf '  to proceed %s(stdin/tty only — argv refused per ps-aux leak)%s:\n' "$_C_DIM" "$_C_RST" >&2
        printf '      %ssecret set <key> --allow-mnemonic%s              # hidden tty prompt\n' "$_C_OK" "$_C_RST" >&2
        printf '      %scat words.txt | secret set <key> --allow-mnemonic%s   # pipe\n' "$_C_OK" "$_C_RST" >&2
        exit 1
      fi
      if [ "$val_from_argv" -eq 1 ]; then
        _die "high-value value via argv refused (ps aux leak) — use stdin/tty"
      fi
    elif is_hex64_value "$val"; then
      printf '%ssecret:%s 64-hex value stored as-is %s(SHA-256 / R2 secret key / HMAC — not treated as a wallet privkey)%s\n' \
        "$_C_WARN" "$_C_RST" "$_C_DIM" "$_C_RST" >&2
    fi
    _store_set "$key" "$val"
    printf '%sstored:%s %s %s(service=%s)%s\n' \
      "$_C_OK" "$_C_RST" "$key" "$_C_DIM" "$SVC" "$_C_RST" >&2
    _maybe_auto_backup
    ;;

  rotate)
    shift
    [ $# -ge 1 ] || _die "usage: secret rotate <key> [--bytes N | --hex N]"
    key="$1"; shift
    mode="bytes"; n=32
    while [ $# -gt 0 ]; do
      case "$1" in
        --bytes) n="${2:?--bytes requires N}"; mode=bytes; shift 2 ;;
        --hex)   n="${2:?--hex requires N}";   mode=hex;   shift 2 ;;
        *) _die "rotate: unknown arg '$1'" ;;
      esac
    done
    case "$mode" in
      bytes) val=$(openssl rand -base64 "$n" | tr -d '\n') ;;
      hex)
        [ "$((n % 2))" -eq 0 ] || _die "--hex N must be even"
        val=$(openssl rand -hex "$((n / 2))") ;;
    esac
    _store_set "$key" "$val"
    printf '%srotated:%s %s %s(service=%s, mode=%s, n=%s)%s — read via %s`secret get %s`%s\n' \
      "$_C_OK" "$_C_RST" "$key" \
      "$_C_DIM" "$SVC" "$mode" "$n" "$_C_RST" \
      "$_C_OK" "$key" "$_C_RST" >&2
    _maybe_auto_backup
    ;;

  check)
    [ $# -ge 2 ] || _die "usage: secret check <key>"
    if _store_has "$2"; then exit 0; else exit 1; fi
    ;;

  list|ls)
    _store_list
    ;;

  delete|rm|del)
    [ $# -ge 2 ] || _die "usage: secret delete <key>"
    if _store_delete "$2"; then
      printf '%sdeleted:%s %s %s(service=%s)%s\n' \
        "$_C_OK" "$_C_RST" "$2" "$_C_DIM" "$SVC" "$_C_RST" >&2
      _maybe_auto_backup
    else
      printf '%ssecret:%s no such key: %s\n' "$_C_FAIL" "$_C_RST" "$2" >&2
      exit 1
    fi
    ;;

  service)
    printf 'service=%s%s%s\n'  "$_C_DIM" "$SVC" "$_C_RST"
    printf 'store=%s%s%s\n'    "$_C_DIM" "$STORE_ENC"  "$_C_RST"
    printf 'git store=%s%s%s\n' "$_C_DIM" "$([ -d "$STORE_DIR/.git" ] && echo yes || echo no)" "$_C_RST"
    ;;

  init)
    shift
    case "${1:-}" in
      github)
        shift
        [ $# -ge 1 ] || _die "init github: usage — secret init github <git-url>"
        _do_init_github "$1"
        ;;
      "") _die "init: usage — secret init github <git-url>" ;;
      *)  _die "init: unknown backend '$1' (expected: github)" ;;
    esac
    ;;

  backup)
    shift
    _do_backup "$@"
    ;;

  sync)
    shift
    [ $# -eq 0 ] || _die "sync: unknown arg '$1'"
    _do_sync
    ;;

  migrate)
    shift
    _do_migrate "$@"
    ;;

  -h|--help|help|"")
    cat <<EOF
${_C_OK}secret${_C_RST} — encrypted-file credential CLI ${_C_DIM}(macOS Keychain-free · github-synced)${_C_RST}

${_C_STEP}verbs:${_C_RST}
  ${_C_OK}secret get${_C_RST}     <key>                        print the secret to stdout (pipe-friendly)
  ${_C_OK}secret set${_C_RST}     [--allow-mnemonic] <key> [value]
                                                 store a secret (hidden prompt if value omitted)
  ${_C_OK}secret rotate${_C_RST}  <key> [--bytes N|--hex N]    generate random + replace (value NEVER printed)
  ${_C_OK}secret check${_C_RST}   <key>                        exit 0 if exists, 1 otherwise
  ${_C_OK}secret delete${_C_RST}  <key>                        remove ${_C_DIM}(aliases: rm, del)${_C_RST}
  ${_C_OK}secret list${_C_RST}                                 list keys ${_C_DIM}(alias: ls)${_C_RST}
  ${_C_OK}secret service${_C_RST}                              print active service / store path

${_C_STEP}master password${_C_RST} ${_C_DIM}(sole decryption secret — same on every device):${_C_RST}
  priority: ${_C_OK}\$SECRET_MASTER${_C_RST} env  →  ${_C_OK}~/.config/secret/master${_C_RST} (0600 file)  →  tty prompt
  ${_C_DIM}argv is NEVER accepted for the master password.${_C_RST}
  Headless / ssh / CI: ${_C_DIM}SECRET_MASTER=… secret get <key>${_C_RST}

${_C_STEP}admin — store location (one-time):${_C_RST}
  ${_C_OK}secret init github${_C_RST} <git-url>                store.enc inside a private git checkout
                                                 ${_C_DIM}(default ~/.local/share/secret/, \$SECRET_GITHUB_PATH override)${_C_RST}

${_C_STEP}admin — additional mirror (additive):${_C_RST}
  ${_C_OK}secret backup enable${_C_RST} <url> [<path>]         add github mirror (clones + persists)
  ${_C_OK}secret backup disable${_C_RST}                       remove mirror config (clone left)
  ${_C_OK}secret backup status${_C_RST}                        show store + mirror + auto state
  ${_C_OK}secret backup${_C_RST}                               push current store.enc
  ${_C_OK}secret sync${_C_RST}                                 git pull --rebase + push (cross-device restore)

${_C_STEP}admin — migration:${_C_RST}
  ${_C_OK}secret migrate --from-keychain${_C_RST} [--purge-source]   one-shot import from the legacy macOS keychain
  ${_C_DIM}(macOS GUI session only — keychain reads need an Aqua session, NOT ssh/headless)${_C_RST}

${_C_STEP}storage:${_C_RST}
  Single openssl-encrypted file ${_C_DIM}store.enc${_C_RST} ${_C_DIM}(aes-256-cbc -pbkdf2 -iter ${ITER})${_C_RST}, decrypted
  in-memory with the master password. Synced as ciphertext through a private
  git repo — no macOS Keychain, no GUI session, works headless / over ssh / linux.
  ${_C_DIM}service  = \$SECRET_SERVICE     (default: dancinlab.secret)${_C_RST}
  ${_C_DIM}store    = \$SECRET_GITHUB_PATH/store.enc  (default: ~/.local/share/secret/store.enc)${_C_RST}

${_C_STEP}high-value protection${_C_RST} ${_C_DIM}(set only)${_C_RST}:
  BIP39 mnemonic (12/15/18/21/24 words) · xprv/xpub/yprv/ypub/zprv/zpub ·
  WIF (5/K/L + 51-52c base58) → ${_C_FAIL}default REFUSE${_C_RST}.
  Override: --allow-mnemonic AND stdin/tty input (argv refused — ps aux leak).
  Bare 64-hex (SHA-256 / R2 key / HMAC / ETH privkey) → ${_C_WARN}WARN${_C_RST}, stored.

${_C_STEP}examples:${_C_RST}
  secret init github https://github.com/dancinlab/secret-vault.git
  secret set github_token ghp_xxxxxxxxxx                        ${_C_DIM}# auto pushes (default)${_C_RST}
  SECRET_MASTER=\$PW secret get github_token                     ${_C_DIM}# headless / ssh${_C_RST}
  secret rotate session_key --bytes 64
  cat id_ed25519 | secret set ssh_key                          ${_C_DIM}# multiline / binary safe${_C_RST}
  TOKEN=\$(secret get github_token)
EOF
    ;;

  *)
    _die "unknown verb '$1' (try: secret --help)"
    ;;
esac
