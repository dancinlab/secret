#!/usr/bin/env bash
# secret — macOS Keychain-backed credential CLI.
# Storage: macOS Keychain via the `security` CLI.
# Service: $SECRET_SERVICE (default: "dancinlab.secret").
# Multi-device: iCloud Keychain syncs entries across the user's Apple devices.
#
# High-value protection (BIP39 mnemonic · xprv/xpub · WIF · 64-hex privkey)
#   - default REFUSE on `set` (wallet-grade · elevated leak risk)
#   - explicit override: `secret set <key> --allow-mnemonic`
#   - argv REFUSED for high-value (ps aux leak); stdin/tty ONLY
#   - BIP39 mnemonic detection validates against bundled wordlist (2048 words)
#     if data/bip39_english.txt is present; falls back to heuristic if absent.
set -euo pipefail

SVC="${SECRET_SERVICE:-dancinlab.secret}"

# Resolve script dir for the bundled wordlist
_SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
_WORDLIST="${_SCRIPT_DIR}/../data/bip39_english.txt"

# TTY guard — restore `stty echo` if we get interrupted mid-prompt
_has_tty() { [ -t 0 ] && [ -t 1 ]; }
trap '_has_tty && stty echo 2>/dev/null; true' EXIT INT TERM

is_high_value_secret() {
  local val="$1"
  local wc
  wc=$(printf '%s' "$val" | wc -w | tr -d ' ')
  case "$wc" in
    12|15|18|21|24)
      if printf '%s' "$val" | grep -Eq '^[a-z]+( [a-z]+)*$'; then
        # If the BIP39 wordlist is bundled, require ALL words to match (accurate).
        # Otherwise fall back to the lowercase-words heuristic.
        if [ -f "$_WORDLIST" ]; then
          local invalid
          invalid=$(printf '%s\n' $val | grep -vxFf "$_WORDLIST" 2>/dev/null | wc -l | tr -d ' ')
          if [ "$invalid" = "0" ]; then return 0; fi
        else
          return 0
        fi
      fi
      ;;
  esac
  if printf '%s' "$val" | grep -Eq '^(xprv|xpub|yprv|ypub|zprv|zpub)[A-HJ-NP-Za-km-z1-9]{100,}$'; then return 0; fi
  if printf '%s' "$val" | grep -Eq '^[5KL][A-HJ-NP-Za-km-z1-9]{50,51}$'; then return 0; fi
  if printf '%s' "$val" | grep -Eq '^(0x)?[0-9a-fA-F]{64}$'; then return 0; fi
  return 1
}

case "${1:-}" in
  get)
    [ $# -ge 2 ] || { echo "usage: secret get <key>" >&2; exit 1; }
    security find-generic-password -a "$2" -s "$SVC" -w
    ;;

  set)
    shift
    allow_mnemonic=0
    posargs=()
    for a in "$@"; do
      case "$a" in
        --allow-mnemonic) allow_mnemonic=1 ;;
        --*) echo "secret set: unknown flag '$a'" >&2; exit 1 ;;
        *) posargs+=("$a") ;;
      esac
    done
    [ "${#posargs[@]}" -ge 1 ] || { echo "usage: secret set [--allow-mnemonic] <key> [value]" >&2; exit 1; }
    key="${posargs[0]}"
    val=""
    val_from_argv=0
    if [ "${#posargs[@]}" -ge 2 ]; then
      val="${posargs[1]}"
      val_from_argv=1
    else
      printf "value for %s: " "$key" >&2
      stty -echo 2>/dev/null || true
      IFS= read -r val || true   # accept EOF without trailing newline (piped values without \n)
      stty echo 2>/dev/null || true
      printf '\n' >&2
    fi
    if is_high_value_secret "$val"; then
      if [ "$allow_mnemonic" -eq 0 ]; then
        cat >&2 <<EOF
secret: high-value secret detected (BIP39 mnemonic · xprv/xpub · WIF · 64-hex privkey)
  refusing by default — wallet-grade secret with elevated leak risk.
  to proceed (stdin/tty only — argv refused per ps-aux leak):
      secret set <key> --allow-mnemonic              # hidden tty prompt
      cat words.txt | secret set <key> --allow-mnemonic   # pipe
EOF
        exit 1
      fi
      if [ "$val_from_argv" -eq 1 ]; then
        echo "secret: high-value value via argv refused (ps aux leak) — use stdin/tty" >&2
        exit 1
      fi
    fi
    security add-generic-password -a "$key" -s "$SVC" -w "$val" -U
    echo "stored: $key (service=$SVC)"
    ;;

  rotate)
    shift
    [ $# -ge 1 ] || { echo "usage: secret rotate <key> [--bytes N | --hex N]" >&2; exit 1; }
    key="$1"; shift
    mode="bytes"; n=32
    while [ $# -gt 0 ]; do
      case "$1" in
        --bytes) n="${2:?--bytes requires N}"; mode=bytes; shift 2 ;;
        --hex)   n="${2:?--hex requires N}";   mode=hex;   shift 2 ;;
        *) echo "secret rotate: unknown arg '$1'" >&2; exit 1 ;;
      esac
    done
    case "$mode" in
      bytes) val=$(openssl rand -base64 "$n" | tr -d '\n') ;;
      hex)
        [ "$((n % 2))" -eq 0 ] || { echo "--hex N must be even" >&2; exit 1; }
        val=$(openssl rand -hex "$((n / 2))") ;;
    esac
    security add-generic-password -a "$key" -s "$SVC" -w "$val" -U
    # NEVER echo the rotated value — sentinel only
    echo "rotated: $key (service=$SVC, mode=$mode, n=$n) — read via \`secret get $key\`"
    ;;

  check)
    [ $# -ge 2 ] || { echo "usage: secret check <key>" >&2; exit 1; }
    if security find-generic-password -a "$2" -s "$SVC" >/dev/null 2>&1; then
      exit 0
    else
      exit 1
    fi
    ;;

  list)
    security dump-keychain 2>/dev/null \
      | awk -v svc="$SVC" '
          /^keychain:/ { acct=""; sv="" }
          /"acct"<blob>=/ { gsub(/.*"acct"<blob>="?|"?$/,""); acct=$0 }
          /"svce"<blob>=/ { gsub(/.*"svce"<blob>="?|"?$/,""); sv=$0
                            if (sv == svc && acct != "") print acct }
        '
    ;;

  delete|rm)
    [ $# -ge 2 ] || { echo "usage: secret delete <key>" >&2; exit 1; }
    security delete-generic-password -a "$2" -s "$SVC" >/dev/null
    echo "deleted: $2 (service=$SVC)"
    ;;

  service)
    echo "$SVC"
    ;;

  -h|--help|help|"")
    cat <<EOF
secret — macOS Keychain-backed credential CLI

verbs:
  secret get <key>                            print the secret (stdout — pipe-friendly)
  secret set [--allow-mnemonic] <key> [value] store a secret (prompts hidden if value omitted)
  secret rotate <key> [--bytes N|--hex N]     generate random + replace (value NEVER printed)
  secret check <key>                          exit 0 if exists, 1 otherwise
  secret delete <key>                         remove
  secret list                                 list keys in this service
  secret service                              print the active service name

storage:
  macOS Keychain via \`security\` CLI
  service = \$SECRET_SERVICE (default: dancinlab.secret)
  iCloud Keychain syncs entries across the user's Apple devices automatically.

high-value protection:
  BIP39 mnemonic (12/15/18/21/24 words, validated against bundled wordlist) ·
  xprv/xpub/yprv/ypub/zprv/zpub · WIF (5/K/L + 51-52c base58) · 64-hex (Ethereum-style)
  → default REFUSE on \`set\`.
  Override: --allow-mnemonic AND stdin/tty input (argv refused — ps aux leak).

rotate:
  --bytes N (default 32) → N bytes of /dev/urandom, base64-encoded
  --hex N               → N hex chars (N must be even)
  value NEVER printed — read after via \`secret get <key>\`.

examples:
  secret set github_token ghp_xxxxxxxxxx                  # ordinary token via argv
  secret set openai_key                                    # hidden tty prompt
  cat words.txt | secret set hot_wallet --allow-mnemonic   # 24-word mnemonic via pipe
  secret rotate session_key --bytes 64                     # new 64-byte secret
  secret check github_token && echo present
  TOKEN=\$(secret get github_token)
  SECRET_SERVICE=work secret list
EOF
    ;;

  *)
    echo "secret: unknown verb '$1' (try: secret --help)" >&2
    exit 1
    ;;
esac
