{
  "project": "secret",
  "profile": "hardcore",
  "stack": [
    "generic"
  ],
  "lockdown": {
    "files": [
      "bin/secret"
    ],
    "fromMarkdown": "CLAUDE.md",
    "onEditReminder": "L0 file edited (bin/secret credential core) — update CHANGELOG.md in the same change."
  },
  "enforcementFile": ".harness/enforcement.json",
  "keywordsFile": ".harness/keywords.json",
  "severityMapFile": ".harness/severity-map.json",
  "verify": {
    "checks": [
      {
        "id": "syntax",
        "cmd": "bash -n bin/secret",
        "timeoutMs": 30000
      }
    ]
  },
  "lint": {
    "freshnessFiles": [],
    "changelog": {
      "file": "CHANGELOG.md",
      "triggerPattern": "(^|/)bin/secret$",
      "ignore": [
        "(^|/)(tests?|__tests__|spec)/",
        "\\.(test|spec)\\.[a-z]+$",
        "(^|/)\\.harness(-engine)?/"
      ]
    },
    "protectedBranches": [
      "main",
      "master"
    ]
  },
  "docs": {
    "architecture": "ARCHITECTURE.md",
    "log": "CHANGELOG.md",
    "scratchDir": "scripts/scratch",
    "scopeDirs": [
      ""
    ],
    "allow": [
      "README.md",
      "CHANGELOG.md",
      "ARCHITECTURE.md",
      "CLAUDE.md",
      "AGENTS.md",
      "LICENSE",
      "CONTRIBUTING.md",
      "SECURITY.md"
    ]
  },
  "guides": [
    "CLAUDE.md",
    "AGENTS.md",
    "README.md"
  ],
  "ledger": {
    "staleSec": 1800
  }
}
